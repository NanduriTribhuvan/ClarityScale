# Contact form email delivery (Resend) — required for the contact API to send mail.
# Copy to `.env` and fill in real values. Never commit `.env`.

# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=

# Verified sender, e.g. "ClarityScale <hello@yourdomain.com>"
CONTACT_FROM=

# Inbox that receives project inquiries
CONTACT_RECIPIENT=

# Public site origin — used for sitemap + canonical/OG URLs.
PUBLIC_SITE_URL=https://clarityscale.example.com

# Optional rate-limit tuning (defaults: 5 submissions / 10 minutes per client)
# CONTACT_RATE_LIMIT=5
# CONTACT_RATE_WINDOW_MS=600000
