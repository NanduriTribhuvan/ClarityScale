      <div class="f-sun"></div>
      <div class="f-layer f-layer--1"></div>
      <div class="f-fog f-fog--1"></div>
      <div class="f-layer f-layer--2"></div>
      <div class="f-fog f-fog--2"></div>
      <div class="f-layer f-layer--3"></div>
      <div class="f-layer f-layer--4"></div>
      <div class="f-fog f-fog--4"></div>
      <div class="f-layer f-layer--5"></div>
      <div class="f-frame f-frame--left"></div>
      <div class="f-frame f-frame--right"></div>
      <canvas class="f-flies" data-f-flies></canvas>
      <div class="f-scrim"></div>
      <div class="f-shade"></div>
    </div>

    <div class="f-wrap f-hero__content">
      <p class="f-eyebrow f-hero__eyebrow"><span class="f-hero__brand">ClarityScale <span aria-hidden="true">/</span></span> Design and development studio</p>
      <h1 class="f-hero__title" id="f-hero-title">
        <span class="f-line"><span>Designed</span></span>
        <span class="f-line"><span>to <em>scale.</em></span></span>
      </h1>
      <p class="f-hero__sign">
        Crafted by <a href="https://www.instagram.com/clarityscale" target="_blank" rel="noopener noreferrer">@clarityscale<span class="f-sr"> (opens Instagram in a new tab)</span></a>
      </p>
    </div>

    <div class="f-wrap f-hero__foot">
      <p class="f-hero__lede">
        We design and build websites, brands and growth plans for businesses that intend to get bigger.
      </p>
      <div class="f-hero__ctas">
        <a href="#contact" class="f-btn f-btn--primary" data-f-magnetic><span>Start a project</span></a>
        <a href="#work" class="f-btn f-btn--ghost"><span>See our work</span></a>
      </div>
    </div>

    <p class="f-hero__scroll" aria-hidden="true"><span>Scroll to walk in</span></p>
  </div>
</section>
