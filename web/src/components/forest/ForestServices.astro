---
// What we make. Each service is a native <details> row, so opening one is
// keyboard- and screen-reader-friendly with no script.
const services = [
  {
    name: 'Websites',
    tag: 'Design and build',
    text: 'Fast, custom-built sites that explain what you do in seconds and make the next step obvious. Built so you can change them without calling us.',
    items: ['Landing pages to full multi-page sites', 'Built to load fast on phones', 'Easy content editing after launch'],
  },
  {
    name: 'Interface design',
    tag: 'Product and UX',
    text: 'Screens people understand on first look. We design the flows that matter most, like booking, joining or buying, and test them before anything is built.',
    items: ['User flows and wireframes', 'High-fidelity designs in Figma', 'Clickable prototypes'],
  },
  {
    name: 'Brand identity',
    tag: 'Look and voice',
    text: 'A logo, colours, type and voice that look like you on every screen, sign and post, written down so anyone on your team can use them.',
    items: ['Logo and mark', 'Colour and type system', 'Brand guidelines'],
  },
  {
    name: 'Search growth',
    tag: 'SEO',
    text: 'Technical SEO built in from the first line of code, then content and local search work that brings in people already looking for you.',
    items: ['Technical SEO and site speed', 'Google Business Profile setup', 'Monthly search reports'],
  },
  {
    name: 'Online stores',
    tag: 'E-commerce',
    text: "Shops on Shopify, WooCommerce or a custom stack, designed around a checkout that doesn't lose people halfway.",
    items: ['Product pages that sell', 'Payments and shipping setup', 'Inventory and order tools'],
  },
  {
    name: 'Marketing',
    tag: 'Social, ads, email',
    text: 'Social, ads and email that sound like your brand and point back to a site built to convert the attention they bring.',
    items: ['Instagram content and ads', 'Email campaigns', 'Results you can read'],
  },
];
---

<section id="services" class="f-section" aria-labelledby="f-services-title">
  <div class="f-wrap">
    <header class="f-head">
      <p class="f-eyebrow"><span>01</span> Services</p>
      <div class="f-head__main">
        <h2 class="f-h2" id="f-services-title" data-f-split>What we <em>make</em></h2>
        <p class="f-lede" data-f-reveal>
          Six things, done properly. Most clients start with a website and add the rest as the
          business grows. Open any of them to see what's included.
        </p>
      </div>
    </header>

    <ol class="f-services">
      {
        services.map((s, i) => (
          <li data-f-reveal style={`--d:${(i * 0.06).toFixed(2)}s`}>
            <details class="f-service" open={i === 0}>
              <summary>
                <span class="f-service__no">{String(i + 1).padStart(2, '0')}</span>
                <span class="f-service__name">{s.name}</span>
                <span class="f-service__tag">{s.tag}</span>
                <span class="f-service__icon" aria-hidden="true" />
              </summary>
              <div class="f-service__body">
                <p>{s.text}</p>
                <ul class="f-ticks">
                  {s.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            </details>
          </li>
        ))
      }
    </ol>
  </div>
</section>
