---
// Recent work: live client sites as a typographic index. Each row is one
// link to the live site; on hover the row floods with that project's colour
// (a shade of the logo palette dark enough for white text).
const projects = [
  {
    name: 'EaglePicks',
    url: 'https://www.eaglepicks.org/',
    domain: 'eaglepicks.org',
    field: 'Sports picks community',
    text: 'A home base for a sports picks community, built so new visitors understand the offer and can join in a few taps.',
    accent: '#1f4fd1',
  },
  {
    name: 'Kan Hustle Fitness',
    url: 'https://www.kanhustlefitness.com/',
    domain: 'kanhustlefitness.com',
    field: 'Fitness and coaching',
    text: "A training brand's site with the energy of the gym floor, built to turn visitors into booked sessions.",
    accent: '#b93c0b',
  },
  {
    name: 'Maa Day Care',
    url: 'https://maa-day-care.vercel.app/',
    domain: 'maa-day-care.vercel.app',
    field: 'Childcare',
    text: 'A warm, calm site that gives parents the answers they look for first and an easy way to get in touch.',
    accent: '#9e1685',
  },
];
---

<section id="work" class="f-section" aria-labelledby="f-work-title">
  <div class="f-wrap">
    <header class="f-head">
      <p class="f-eyebrow"><span>02</span> Work</p>
      <div class="f-head__main">
        <h2 class="f-h2" id="f-work-title" data-f-split>Recent <em>work</em></h2>
        <p class="f-lede" data-f-reveal>
          Live sites we designed and built for growing businesses. Each one opens in a new tab, so
          you can see how it feels on your own phone.
        </p>
      </div>
    </header>

    <ol class="f-projects">
      {
        projects.map((p, i) => (
          <li class="f-project" data-f-reveal style={`--accent:${p.accent};--d:${i * 0.08}s`}>
            <a class="f-project__link" href={p.url} target="_blank" rel="noopener noreferrer">
              <span class="f-project__no">{String(i + 1).padStart(2, '0')}</span>
              <span class="f-project__main">
                <span class="f-project__name">{p.name}</span>
                <span class="f-project__text">{p.text}</span>
              </span>
              <span class="f-project__meta">
                <span>{p.field}</span>
                <span>{p.domain}</span>
              </span>
              <span class="f-project__go" aria-hidden="true">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 18 18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M5 13 13 5M6.5 5H13v6.5" />
                </svg>
              </span>
              <span class="f-sr">(opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>
