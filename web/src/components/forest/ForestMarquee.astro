---
// The tagline carried through the trees. Purely decorative (the same words
// are the page's h1 and sign-off), so it is hidden from assistive tech.
// The group is repeated so src/scripts/forest.ts can loop it seamlessly and
// speed it up with scroll velocity.
---

<div class="f-marquee" aria-hidden="true" data-f-marquee>
  <div class="f-marquee__track" data-f-marquee-track>
    <div class="f-marquee__group">
      <span class="f-marquee__item"
        ><span class="f-marquee__solid">Designed to scale</span><span class="f-marquee__star"
        ></span></span
      >
      <span class="f-marquee__item"
        ><span class="f-marquee__serif">Crafted by @clarityscale</span><span
          class="f-marquee__star"></span></span
      >
      <span class="f-marquee__item"
        ><span class="f-marquee__outline">Websites, brands, growth</span><span
          class="f-marquee__star"></span></span
      >
    </div>
    <div class="f-marquee__group">
      <span class="f-marquee__item"
        ><span class="f-marquee__solid">Designed to scale</span><span class="f-marquee__star"
        ></span></span
      >
      <span class="f-marquee__item"
        ><span class="f-marquee__serif">Crafted by @clarityscale</span><span
          class="f-marquee__star"></span></span
      >
      <span class="f-marquee__item"
        ><span class="f-marquee__outline">Websites, brands, growth</span><span
          class="f-marquee__star"></span></span
      >
    </div>
  </div>
</div>
