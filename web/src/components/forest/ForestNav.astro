---
import ForestMark from './ForestMark.astro';

interface Props {
  /** Prefix for in-page anchors: "" on the homepage, "/" on interior pages. */
  base?: string;
}
const { base = '' } = Astro.props;
---

<a class="f-skip" href="#main">Skip to content</a>

<header class="f-nav" data-f-nav>
  <div class="f-wrap f-nav__inner">
    <a href={`${base}#home`} class="f-brand" aria-label="ClarityScale home">
      <ForestMark />
      <span>ClarityScale</span>
    </a>

    <nav aria-label="Main">
      <ul class="f-nav__links">
        <li><a href={`${base}#services`} class="nav-link">Services</a></li>
        <li><a href={`${base}#work`} class="nav-link">Work</a></li>
        <li><a href={`${base}#how-it-works`} class="nav-link">Process</a></li>
        <li><a href={`${base}#pricing`} class="nav-link">Pricing</a></li>
        <li><a href="/blog" class="nav-link">Journal</a></li>
      </ul>
    </nav>

    <a href={`${base}#contact`} class="f-btn f-btn--primary f-btn--sm f-nav__cta" data-f-magnetic
      ><span>Start a project</span></a
    >

    <button
      type="button"
      class="f-nav__toggle"
      aria-expanded="false"
      aria-controls="f-menu"
      data-f-menu-toggle
    >
      <span class="f-nav__bars" aria-hidden="true"></span>
      <span class="f-sr">Menu</span>
    </button>
  </div>
</header>

<div class="f-menu" id="f-menu" hidden>
  <nav aria-label="Mobile">
    <ul>
      <li style="--i:0">
        <a href={`${base}#services`} class="f-menu__link"><span>01</span>Services</a>
      </li>
      <li style="--i:1"><a href={`${base}#work`} class="f-menu__link"><span>02</span>Work</a></li>
      <li style="--i:2">
        <a href={`${base}#how-it-works`} class="f-menu__link"><span>03</span>Process</a>
      </li>
      <li style="--i:3">
        <a href={`${base}#pricing`} class="f-menu__link"><span>04</span>Pricing</a>
      </li>
      <li style="--i:4"><a href="/blog" class="f-menu__link"><span>05</span>Journal</a></li>
    </ul>
  </nav>
  <div class="f-menu__foot">
    <a href={`${base}#contact`} class="f-btn f-btn--primary"><span>Start a project</span></a>
    <p class="f-menu__sign">
      Designed to scale. Crafted by <a
        href="https://www.instagram.com/clarityscale"
        target="_blank"
        rel="noopener noreferrer">@clarityscale</a
      >
    </p>
  </div>
</div>
