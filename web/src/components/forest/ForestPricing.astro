---
// Pricing. Monthly retainer vs one project. The toggle (src/scripts/forest.ts)
// swaps each [data-f-price] / [data-f-period] between its data-monthly and
// data-project values. Without JavaScript the monthly prices stay visible.
const plans = [
  {
    name: 'Starter',
    desc: 'For a small business or solo founder who needs a strong site, fast.',
    monthly: '499',
    project: '1,299',
    cta: 'Choose Starter',
    items: [
      'Five-page website, designed and built',
      'Works beautifully on every phone',
      'Search setup',
      'Logo and brand colours',
      'One round of revisions',
    ],
  },
  {
    name: 'Growth',
    desc: 'For a business that needs its whole online presence handled.',
    monthly: '1,299',
    project: '3,499',
    cta: 'Choose Growth',
    lit: true,
    items: [
      'Website up to 15 pages',
      'Full brand identity',
      'Search growth plan',
      'Social media management',
      'Monthly results report',
      'Online store ready',
    ],
  },
  {
    name: 'Scale',
    desc: 'For an established team that wants a dedicated studio on call.',
    cta: 'Talk to us',
    items: [
      'Everything in Growth',
      'Custom web apps',
      'Paid ads and email campaigns',
      'A dedicated contact',
      'Quarterly strategy sessions',
    ],
  },
];
---

<section id="pricing" class="f-section" aria-labelledby="f-pricing-title">
  <div class="f-wrap">
    <header class="f-head">
      <p class="f-eyebrow"><span>04</span> Pricing</p>
      <div class="f-head__main">
        <h2 class="f-h2" id="f-pricing-title" data-f-split>Simple, <em>honest</em> pricing</h2>
        <div class="f-pricing__bar" data-f-reveal>
          <p class="f-lede">
            Pay monthly and we stay on as your web team, or pay once for a single project. Every
            price is agreed in writing before work starts.
          </p>
          <div
            class="f-billing"
            role="group"
            aria-label="Billing"
            data-f-billing
            data-mode="monthly"
          >
            <span class="f-billing__thumb" aria-hidden="true"></span>
            <button type="button" data-mode="monthly" aria-pressed="true">Monthly</button>
            <button type="button" data-mode="project" aria-pressed="false">One project</button>
          </div>
        </div>
      </div>
    </header>

    <ul class="f-plans">
      {
        plans.map((p, i) => (
          <li
            class:list={['f-plan', { 'f-plan--lit': p.lit }]}
            data-f-reveal
            style={`--d:${i * 0.08}s`}
          >
            <div class="f-plan__top">
              <h3 class="f-plan__name">{p.name}</h3>
              {p.lit && <span class="f-plan__flag">Most chosen</span>}
            </div>
            <p class="f-plan__desc">{p.desc}</p>
            {p.monthly ? (
              <>
                <p class="f-price">
                  <span class="f-price__cur">$</span>
                  <span
                    class="f-price__amt"
                    data-f-price
                    data-monthly={p.monthly}
                    data-project={p.project}
                  >
                    {p.monthly}
                  </span>
                </p>
                <p
                  class="f-price__per"
                  data-f-period
                  data-monthly="per month"
                  data-project="one project"
                >
                  per month
                </p>
              </>
            ) : (
              <>
                <p class="f-price">
                  <span class="f-price__amt">Custom</span>
                </p>
                <p class="f-price__per">Quoted after a call</p>
              </>
            )}
            <a
              href="#contact"
              class:list={['f-btn', 'f-btn--full', p.lit ? 'f-btn--primary' : 'f-btn--ghost']}
            >
              <span>{p.cta}</span>
            </a>
            <ul class="f-ticks">
              {p.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
    <p class="f-pricing__note">
      Prices in US dollars. Not sure which fits? Ask us and we'll tell you honestly.
    </p>
  </div>
</section>
