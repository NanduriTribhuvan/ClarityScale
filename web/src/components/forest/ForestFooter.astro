---
import ContactForm from '../ContactForm.tsx';

// Contact, direct channels and the sign-off, then you walk out of the
// forest into a sunrise in the logo's colours. The footer keeps id="contact"
// so every "Start a project" link lands here.
interface Props {
  /** Prefix for in-page anchors: "" on the homepage, "/" on interior pages. */
  base?: string;
}
const { base = '' } = Astro.props;
const year = new Date().getFullYear();
---

<footer id="contact" class="f-footer" aria-labelledby="f-contact-title">
  <div class="f-wrap">
    <header class="f-head">
      <p class="f-eyebrow"><span>05</span> Contact</p>
      <div class="f-head__main">
        <h2 class="f-h2" id="f-contact-title" data-f-split>Start a <em>project</em></h2>
      </div>
    </header>

    <div class="f-contact">
      <div class="f-contact__info" data-f-reveal>
        <p class="f-lede">
          Tell us what you're building and where you want it to be in a year. We'll reply within
          one working day with next steps and a rough price.
        </p>
        <ul class="f-channels">
          <li>
            <a href="mailto:contact.clarityscale@gmail.com"
              ><span class="f-channels__k">Email</span><span class="f-channels__v"
                >contact.clarityscale@gmail.com</span
              ></a
            >
          </li>
          <li>
            <a href="https://wa.me/916301050825" target="_blank" rel="noopener noreferrer"
              ><span class="f-channels__k">WhatsApp</span><span class="f-channels__v"
                >+91 63010 50825</span
              ></a
            >
          </li>
          <li>
            <a
              href="https://www.instagram.com/clarityscale"
              target="_blank"
              rel="noopener noreferrer"
              ><span class="f-channels__k">Instagram</span><span class="f-channels__v"
                >@clarityscale</span
              ></a
            >
          </li>
        </ul>
      </div>

      <div class="f-contact__form" data-f-reveal style="--d:0.1s">
        <ContactForm client:visible />
      </div>
    </div>
  </div>

  <div class="f-dawn">
    <div class="f-wrap">
      <p class="f-signoff">
        <span class="f-signoff__big" data-f-split>Designed to <em>scale.</em></span>
        <span class="f-signoff__by"
          >Crafted by <a
            href="https://www.instagram.com/clarityscale"
            target="_blank"
            rel="noopener noreferrer">@clarityscale</a
          ></span
        >
      </p>
    </div>
    <div class="f-dawn__trees" aria-hidden="true">
      <div class="f-dawn__back"></div>
      <div class="f-dawn__front"></div>
    </div>
  </div>

  <div class="f-footbar">
    <div class="f-wrap f-footbar__inner">
      <p>&copy; {year} ClarityScale</p>
      <ul>
        <li><a href={`${base}#services`}>Services</a></li>
        <li><a href={`${base}#work`}>Work</a></li>
        <li><a href="/blog">Journal</a></li>
        <li><a href="/privacy">Privacy</a></li>
        <li><a href="/terms">Terms</a></li>
      </ul>
    </div>
  </div>
</footer>
