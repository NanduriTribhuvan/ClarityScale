---
import ContactForm from '../ContactForm.tsx';

// The clearing: contact, direct channels and the sign-off. The footer keeps
// id="contact" so every "Start a project" link lands here.
interface Props {
  /** Prefix for in-page anchors: "" on the homepage, "/" on interior pages. */
  base?: string;
}
const { base = '' } = Astro.props;
const year = new Date().getFullYear();
---

<footer id="contact" class="f-clearing" aria-labelledby="f-contact-title">
  <div class="f-wrap f-contact">
    <div data-f-reveal>
      <h2 class="f-h2" id="f-contact-title">Start a project</h2>
      <p class="f-lede">
        Tell us what you're building and where you want it to be in a year. We'll reply with next
        steps and a rough price.
      </p>
      <ul class="f-channels">
        <li>
          <a href="mailto:contact.clarityscale@gmail.com"
            >Email <span>contact.clarityscale@gmail.com</span></a
          >
        </li>
        <li>
          <a href="https://wa.me/916301050825" target="_blank" rel="noopener noreferrer"
            >WhatsApp <span>+91 63010 50825</span></a
          >
        </li>
        <li>
          <a href="https://www.instagram.com/clarityscale" target="_blank" rel="noopener noreferrer"
            >Instagram <span>@clarityscale</span></a
          >
        </li>
      </ul>
    </div>

    <div data-f-reveal style="--d:0.1s">
      <ContactForm client:visible />
    </div>
  </div>

  <div class="f-wrap">
    <p class="f-signoff" data-f-reveal>
      Designed to scale.
      <span
        >Crafted by <a
          href="https://www.instagram.com/clarityscale"
          target="_blank"
          rel="noopener noreferrer">@clarityscale</a
        ></span
      >
    </p>
  </div>

