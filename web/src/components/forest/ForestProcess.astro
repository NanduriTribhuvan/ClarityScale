---
// How a project goes: a real sequence, drawn as a path that fills in as you
// scroll (--trail, set by src/scripts/forest.ts). Steps light up in turn.
const steps = [
  {
    title: 'Talk',
    text: "A short call about your business, your customers and what isn't working today. No prep needed.",
  },
  {
    title: 'Plan',
    text: 'We map the pages, the content and the one thing the site has to do. You get a written scope and a price before design starts.',
  },
  {
    title: 'Design and build',
    text: "You see real pages early and give feedback as we go. Nothing ships until you've approved it.",
  },
  {
    title: 'Launch and grow',
    text: 'We launch, watch how people use the site, and keep improving the parts that bring in customers.',
  },
];
---

<section
  id="how-it-works"
  class="f-section f-process"
  data-f-trail
  aria-labelledby="f-process-title"
>
  <div class="f-wrap">
    <header class="f-head">
      <p class="f-eyebrow"><span>03</span> Process</p>
      <div class="f-head__main">
        <h2 class="f-h2" id="f-process-title" data-f-split>How a project <em>goes</em></h2>
        <p class="f-lede" data-f-reveal>
          Four steps, the same every time. You always know where we are, what's next and what it
          costs.
        </p>
      </div>
    </header>

    <ol class="f-steps">
      {
        steps.map((s, i) => (
          <li class="f-step" data-f-reveal style={`--d:${i * 0.08}s`}>
            <span class="f-step__no">Step {i + 1}</span>
            <h3 class="f-h3">{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
