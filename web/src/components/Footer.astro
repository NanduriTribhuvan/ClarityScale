---
import Logo from './Logo.astro';
import ContactForm from './ContactForm.tsx';
// Footer doubles as the #contact landmark (contentinfo). The net-new contact
// form (hydrated island) sits at the top of the contact area.
interface Props {
  /** Prefix for in-page anchors — "" on homepage, "/" on sub-pages. */
  linkBase?: string;
}
const { linkBase = '' } = Astro.props;
---

<footer id="contact" class="footer" role="contentinfo">
  <div class="container">
    <ContactForm client:visible />
    <div class="footer-top">
      <div class="footer-brand">
        <a href={`${linkBase}#home`} class="nav-logo footer-logo">
          <span class="logo-icon"><Logo variant="footer" /></span>
          <span class="logo-text">ClarityScale</span>
        </a>
        <p class="footer-tagline">Your digital growth hub. We guide businesses to scale smarter and faster through world-class web development, branding, and digital strategy.</p>
        <div class="footer-socials">
          <a href="https://www.instagram.com/clarityscale/" target="_blank" rel="noopener noreferrer" class="social-link" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="#" class="social-link" aria-label="Twitter"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg></a>
          <a href="#" class="social-link" aria-label="LinkedIn"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg></a>
        </div>
      </div>

      <div class="footer-links-grid">
        <div class="footer-col">
          <h4>Services</h4>
          <ul>
            <li><a href={`${linkBase}#services`}>Website Development</a></li>
            <li><a href={`${linkBase}#services`}>UI/UX Design</a></li>
            <li><a href={`${linkBase}#services`}>Brand Identity</a></li>
            <li><a href={`${linkBase}#services`}>SEO &amp; Growth</a></li>
            <li><a href={`${linkBase}#services`}>E-Commerce</a></li>
            <li><a href={`${linkBase}#services`}>Digital Marketing</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Company</h4>
          <ul>
            <li><a href={`${linkBase}#home`}>About Us</a></li>
            <li><a href="/work">Our Work</a></li>
            <li><a href={`${linkBase}#how-it-works`}>Our Process</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href={`${linkBase}#contact`}>Careers</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Get Started</h4>
          <ul>
            <li><a href={`${linkBase}#pricing`}>Pricing</a></li>
            <li><a href={`${linkBase}#contact`}>Free Consultation</a></li>
            <li><a href={`${linkBase}#contact`}>Start a Project</a></li>
            <li><a href="https://www.instagram.com/clarityscale/" target="_blank" rel="noopener noreferrer">Instagram</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h4>Contact</h4>
          <ul>
            <li><a href="mailto:contact.clarityscale@gmail.com">contact.clarityscale@gmail.com</a></li>
            <li><a href="tel:+916301050825">+91 6301050825</a></li>
            <li><a href="https://wa.me/916301050825" target="_blank" rel="noopener noreferrer">WhatsApp Us</a></li>
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="/terms">Terms of Service</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© 2025 ClarityScale. All rights reserved. Your digital growth hub.</p>
      <div class="footer-bottom-links">
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="https://www.instagram.com/clarityscale/" target="_blank" rel="noopener noreferrer">Instagram</a>
      </div>
    </div>
  </div>
</footer>
