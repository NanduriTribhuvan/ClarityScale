---
import Logo from './Logo.astro';
// Call-to-action band with email / WhatsApp / Instagram contact channels.
---

<section class="cta-section section" aria-label="Call to action">
  <div class="container">
    <div class="cta-box" data-scroll-reveal>
      <div class="cta-orb cta-orb-1" aria-hidden="true"></div>
      <div class="cta-orb cta-orb-2" aria-hidden="true"></div>
      <div class="cta-logo" aria-hidden="true"><Logo variant="cta" /></div>
      <h2 class="cta-headline">Ready to scale smarter?</h2>
      <p class="cta-sub">Let's build something that genuinely grows your business. Tell us about your project and we'll get back to you within 24 hours.</p>
      <div class="cta-buttons">
        <a href="mailto:contact.clarityscale@gmail.com" class="btn btn-primary btn-xl">Email Us Now</a>
        <a href="https://wa.me/916301050825" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-xl">WhatsApp Us</a>
      </div>
      <p class="cta-footnote">Free initial consultation · No commitment · Real results</p>
      <div class="cta-contact-strip">
        <a href="mailto:contact.clarityscale@gmail.com" class="cta-contact-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          contact.clarityscale@gmail.com
        </a>
        <span class="cta-contact-sep">·</span>
        <a href="tel:+916301050825" class="cta-contact-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          +91 6301050825
        </a>
        <span class="cta-contact-sep">·</span>
        <a href="https://www.instagram.com/clarityscale/" target="_blank" rel="noopener noreferrer" class="cta-contact-item">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          @clarityscale
        </a>
      </div>
    </div>
  </div>
</section>
