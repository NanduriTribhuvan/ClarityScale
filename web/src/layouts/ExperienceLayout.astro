---
import ExperienceLayer from '../components/ExperienceLayer.astro';
import ExperienceEngine from '../components/ExperienceEngine.tsx';

// Same design system + experience chrome as BaseLayout, but driven by the
// upgraded ExperienceEngine island (ScrollTrigger pins, SplitText kinetic
// type, magnetic cursor, parallax) instead of the baseline Animations island.
import '../styles/global.css';
import '../styles/experience.css';
import '../styles/additions.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ClarityScale — Digital Growth Hub',
  description = 'ClarityScale is a digital growth hub that guides businesses to scale smarter and faster through world-class web development, branding, and digital strategy.',
} = Astro.props;

const ogDescription =
  'We build websites, brands, and digital strategies that scale businesses smarter and faster.';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030309" />
    <link rel="canonical" href={canonical} />

    {/* Open Graph */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    {/* Fonts: Syne (display) + DM Sans (body) */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <ExperienceLayer />

    <slot />

    {/*
      The Living Growth Engine. Hydrates on idle, loads GSAP + plugins from npm,
      and wires the cinematic layer onto the pre-rendered DOM. Only this + the
      hero canvas + the Idea Board hydrate — the page is never hydrated wholesale.
    */}
    <ExperienceEngine client:idle />
  </body>
</html>
