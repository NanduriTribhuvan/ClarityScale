---
import ForestHead from '../components/forest/ForestHead.astro';
import ForestMark from '../components/forest/ForestMark.astro';
// Homepage shell. additions.css carries the contact form's base styles;
// forest.css is the design system and must load last.
import '../styles/additions.css';
import '../styles/forest.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ClarityScale | Designed to scale. Crafted by @clarityscale',
  description = 'ClarityScale is a design and development studio building websites, brands and growth plans for businesses that intend to get bigger.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <ForestHead title={title} description={description} intro />
  </head>
  <body class="forest">
    <div class="f-intro" aria-hidden="true">
      <div class="f-intro__mark">
        <ForestMark size={92} />
        <span class="f-intro__word">ClarityScale</span>
      </div>
    </div>
    <div class="f-glow" aria-hidden="true" data-f-glow></div>
    <slot />
    <script>
      import '../scripts/forest.ts';
    </script>
  </body>
</html>
