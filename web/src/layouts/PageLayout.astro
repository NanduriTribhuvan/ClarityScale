---
import ForestHead from '../components/forest/ForestHead.astro';
import ForestNav from '../components/forest/ForestNav.astro';
import ForestFooter from '../components/forest/ForestFooter.astro';
import Animations from '../components/Animations.tsx';

import '../styles/global.css';
import '../styles/experience.css';
import '../styles/additions.css';
// Forest theme last: it re-maps the shared tokens (colours, fonts) so the
// blog, work and legal styles inherit the forest palette.
import '../styles/forest.css';

/**
 * Shared shell for interior pages (work, blog, legal). Uses the forest
 * navigation and footer (with contact form); nav links resolve back to
 * homepage sections via base="/". The Animations island keeps the page-level
 * scroll reveals these pages rely on.
 */
interface Props {
  title: string;
  description?: string;
  ogType?: string;
}

const {
  title,
  description = 'ClarityScale is a design and development studio building websites, brands and growth plans for businesses that intend to get bigger.',
  ogType = 'website',
} = Astro.props;

const pageTitle = title.includes('ClarityScale') ? title : `${title} | ClarityScale`;
---

<!doctype html>
<html lang="en">
  <head>
    <ForestHead title={pageTitle} description={description} ogType={ogType} />
    <slot name="head" />
  </head>
  <body class="forest">
    <ForestNav base="/" />

    <main class="page-main" id="main">
      <slot />
    </main>

    <ForestFooter base="/" />

    <Animations client:idle />
    <script>
      import '../scripts/forest.ts';
    </script>
  </body>
</html>
