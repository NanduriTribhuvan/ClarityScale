---
{/*
  TEMPLATE LEGAL DOCUMENT — NOT LEGAL ADVICE.
  This Privacy Policy is a starting template only. ClarityScale should have
  qualified legal counsel review and tailor it to the business, jurisdiction,
  and actual data practices before relying on it or publishing it as binding.
*/}
import PageLayout from '../layouts/PageLayout.astro';
import '../styles/legal.css';

/**
 * Privacy Policy — styled legal page with a sticky table-of-contents sidebar
 * on desktop (collapses on mobile). Pre-rendered: content is fully static.
 */
export const prerender = true;

const lastUpdated = 'June 11, 2026';

const sections = [
  { id: 'introduction', label: 'Introduction' },
  { id: 'information-we-collect', label: 'Information We Collect' },
  { id: 'how-we-use-information', label: 'How We Use Information' },
  { id: 'cookies-analytics', label: 'Cookies & Analytics' },
  { id: 'data-sharing', label: 'Data Sharing & Third Parties' },
  { id: 'data-retention', label: 'Data Retention' },
  { id: 'your-rights', label: 'Your Rights' },
  { id: 'security', label: 'Security' },
  { id: 'childrens-privacy', label: "Children's Privacy" },
  { id: 'changes', label: 'Changes to this Policy' },
  { id: 'contact', label: 'Contact Us' },
];
---

<PageLayout
  title="Privacy Policy"
  description="How ClarityScale collects, uses, and protects your information, including data submitted through our contact form."
>
  <section class="legal-page">
    <div class="legal-shell">
      <header class="legal-header">
        <span class="legal-eyebrow">Legal</span>
        <h1>Privacy <span class="gradient-text">Policy</span></h1>
        <p class="legal-updated">Last updated: {lastUpdated}</p>
        <p class="legal-intro-note">
          This page explains what information ClarityScale collects, how we use it, and the
          choices you have. Please read it alongside our Terms of Service. If anything is
          unclear, reach out using the contact details below.
        </p>
      </header>

      <div class="legal-grid">
        <aside class="legal-toc" aria-label="Table of contents">
          <p class="legal-toc-title">On this page</p>
          <nav>
            <ul>
              {sections.map((s) => (
                <li><a href={`#${s.id}`}>{s.label}</a></li>
              ))}
            </ul>
          </nav>
        </aside>

        <div class="legal-content">
          <section id="introduction" class="legal-section">
            <h2>Introduction</h2>
            <p>
              ClarityScale ("ClarityScale", "we", "us", or "our") is a digital growth hub that
              builds websites, brands, and strategies for businesses. We respect your privacy and
              are committed to protecting the personal information you share with us.
            </p>
            <p>
              This Privacy Policy describes how we collect, use, disclose, and safeguard your
              information when you visit our website or interact with us, including when you submit
              our contact form. By using our website, you agree to the practices described here.
            </p>
          </section>

          <section id="information-we-collect" class="legal-section">
            <h2>Information We Collect</h2>
            <p>We collect information in the following ways:</p>
            <h3>Information you provide</h3>
            <p>
              When you submit our contact form, we collect the information you enter, which
              typically includes your:
            </p>
            <ul>
              <li><strong>Name</strong> — so we know who we are talking to.</li>
              <li><strong>Email address</strong> — so we can respond to your enquiry.</li>
              <li>
                <strong>Message</strong> — the contents of your enquiry and any details you choose
                to include.
              </li>
            </ul>
            <h3>Information collected automatically</h3>
            <p>
              When you visit our website, we may automatically receive limited technical
              information such as your browser type, device type, referring pages, and general
              usage data. This information helps us understand how the site is used and keep it
              running reliably.
            </p>
          </section>

          <section id="how-we-use-information" class="legal-section">
            <h2>How We Use Information</h2>
            <p>We use the information we collect to:</p>
            <ul>
              <li>Respond to your enquiries and provide the services you request.</li>
              <li>Communicate with you about projects, proposals, and updates.</li>
              <li>Operate, maintain, and improve our website and services.</li>
              <li>Analyse usage trends to enhance the user experience.</li>
              <li>Comply with legal obligations and protect our rights.</li>
            </ul>
            <p>
              We do not sell your personal information, and we do not use contact form submissions
              for unrelated marketing without your consent.
            </p>
          </section>

          <section id="cookies-analytics" class="legal-section">
            <h2>Cookies &amp; Analytics</h2>
            <p>
              Our website may use cookies and similar technologies to remember your preferences and
              understand how visitors interact with our pages. Cookies are small files stored on
              your device.
            </p>
            <p>
              We may use privacy-conscious analytics tools to measure aggregate traffic and
              performance. You can control or disable cookies through your browser settings, though
              some features of the site may not function as intended if you do.
            </p>
          </section>

          <section id="data-sharing" class="legal-section">
            <h2>Data Sharing &amp; Third Parties</h2>
            <p>
              We share personal information only as needed to operate our services and never sell
              it. We may share information with:
            </p>
            <ul>
              <li>
                <strong>Email delivery providers</strong> — to transmit and receive messages sent
                through our contact form and to reply to your enquiries.
              </li>
              <li>
                <strong>Hosting and infrastructure providers</strong> — to host and serve our
                website.
              </li>
              <li>
                <strong>Analytics providers</strong> — to help us understand aggregate site usage.
              </li>
              <li>
                <strong>Legal and regulatory authorities</strong> — where required by law or to
                protect our rights.
              </li>
            </ul>
            <p>
              These third parties are only authorised to process your information as necessary to
              provide their services to us and are expected to safeguard it appropriately.
            </p>
          </section>

          <section id="data-retention" class="legal-section">
            <h2>Data Retention</h2>
            <p>
              We retain personal information only for as long as necessary to fulfil the purposes
              described in this policy, including to respond to your enquiry, maintain our business
              records, and comply with legal obligations.
            </p>
            <p>
              When information is no longer needed, we take reasonable steps to delete or anonymise
              it. You may request deletion of your information as described in the section below.
            </p>
          </section>

          <section id="your-rights" class="legal-section">
            <h2>Your Rights</h2>
            <p>
              Depending on your location, you may have rights under laws such as the EU/UK General
              Data Protection Regulation (GDPR) and the California Consumer Privacy Act (CCPA).
              These may include the right to:
            </p>
            <ul>
              <li><strong>Access</strong> the personal information we hold about you.</li>
              <li><strong>Correct</strong> inaccurate or incomplete information.</li>
              <li><strong>Delete</strong> your personal information.</li>
              <li><strong>Restrict or object</strong> to certain processing.</li>
              <li><strong>Data portability</strong> — receive your data in a portable format.</li>
              <li>
                <strong>Opt out</strong> of the sale of personal information (we do not sell it) and
                withdraw consent where processing is based on consent.
              </li>
            </ul>
            <p>
              To exercise any of these rights, contact us using the details below. We will not
              discriminate against you for exercising your privacy rights.
            </p>
          </section>

          <section id="security" class="legal-section">
            <h2>Security</h2>
            <p>
              We use reasonable administrative, technical, and organisational measures to protect
              personal information against unauthorised access, loss, misuse, or alteration. No
              method of transmission over the internet or electronic storage is completely secure,
              however, so we cannot guarantee absolute security.
            </p>
          </section>

          <section id="childrens-privacy" class="legal-section">
            <h2>Children's Privacy</h2>
            <p>
              Our website and services are not directed to children under the age of 13 (or the
              minimum age required in your jurisdiction), and we do not knowingly collect personal
              information from children. If you believe a child has provided us with personal
              information, please contact us and we will take steps to delete it.
            </p>
          </section>

          <section id="changes" class="legal-section">
            <h2>Changes to this Policy</h2>
            <p>
              We may update this Privacy Policy from time to time to reflect changes in our
              practices or legal requirements. When we do, we will revise the "Last updated" date
              at the top of this page. We encourage you to review this policy periodically.
            </p>
          </section>

          <section id="contact" class="legal-section">
            <h2>Contact Us</h2>
            <p>
              If you have questions about this Privacy Policy or how we handle your information, you
              can reach us at:
            </p>
            <div class="legal-contact-card">
              <p>
                <strong>Email:</strong>
                <a href="mailto:contact.clarityscale@gmail.com">contact.clarityscale@gmail.com</a>
              </p>
              <p>
                <strong>Instagram:</strong>
                <a href="https://instagram.com/clarityscale" target="_blank" rel="noopener noreferrer">@clarityscale</a>
              </p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
