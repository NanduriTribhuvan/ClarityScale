---
import ForestLayout from '../layouts/ForestLayout.astro';
import ForestNav from '../components/forest/ForestNav.astro';
import ForestHero from '../components/forest/ForestHero.astro';
import ForestManifesto from '../components/forest/ForestManifesto.astro';
import ForestServices from '../components/forest/ForestServices.astro';
import ForestWork from '../components/forest/ForestWork.astro';
import ForestProcess from '../components/forest/ForestProcess.astro';
import ForestPricing from '../components/forest/ForestPricing.astro';
import ForestFooter from '../components/forest/ForestFooter.astro';

// The forest homepage: you walk down the clearing at dusk (hero), through
// the woods (studio, services, work, process, pricing) and out into the dawn
// (contact). Static markup is pre-rendered; only the contact form hydrates.
export const prerender = true;
---

<ForestLayout>
  <ForestNav />
  <main id="main">
    <ForestHero />
    <ForestManifesto />
    <ForestServices />
    <ForestWork />
    <ForestProcess />
    <ForestPricing />
  </main>
  <ForestFooter />
</ForestLayout>
