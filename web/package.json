{
  "name": "clarityscale",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "ClarityScale — Digital Growth Hub (Astro + Node, TypeScript migration)",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:install": "playwright install"
  },
  "dependencies": {
    "@astrojs/node": "^9.1.3",
    "@astrojs/preact": "^4.0.4",
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.4.0",
    "gsap": "^3.13.0",
    "preact": "^10.25.4",
    "resend": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.5",
    "eslint": "^9.21.0",
    "eslint-plugin-astro": "^1.3.1",
    "prettier": "^3.5.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.24.1",
    "vitest": "^2.1.9"
  }
}
